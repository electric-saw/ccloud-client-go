func (*ConnectV1AlterOffsetRequestInfo) alterConnectv1ConnectorOffsetsRequestRes() {}


// The type of alter operation. PATCH will update the offset to the provided values. The update will
// only happen for the partitions provided in the request. DELETE will delete the offset for the
// provided partitions and reset them back to the base state. It is as if, a fresh new connector was
// created.
//
// For sink connectors PATCH/DELETE will move the offsets to the provided point in the topic partition.
// If the offset provided is not present in the topic partition it will by default reset to the
// earliest offset in the topic partition.
//
// For source connectors, post PATCH/DELETE the connector will attempt to read from the position
// defined in the altered offsets.
	// Ref: #/components/schemas/connect.v1.AlterOffsetRequestType
type ConnectV1AlterOffsetRequestType string

const (
	ConnectV1AlterOffsetRequestTypePATCH ConnectV1AlterOffsetRequestType = "PATCH"
	ConnectV1AlterOffsetRequestTypeDELETE ConnectV1AlterOffsetRequestType = "DELETE"
)

// AllValues returns all ConnectV1AlterOffsetRequestType values.
func (ConnectV1AlterOffsetRequestType) AllValues() []ConnectV1AlterOffsetRequestType {
	return []ConnectV1AlterOffsetRequestType{
		ConnectV1AlterOffsetRequestTypePATCH,
		ConnectV1AlterOffsetRequestTypeDELETE,
	}
}

// MarshalText implements encoding.TextMarshaler.
func (s ConnectV1AlterOffsetRequestType) MarshalText() ([]byte, error) {
	switch s {
	case ConnectV1AlterOffsetRequestTypePATCH:
		return []byte(s), nil
	case ConnectV1AlterOffsetRequestTypeDELETE:
		return []byte(s), nil
	default:
		return nil, errors.Errorf("invalid value: %q", s)
	}
}

// UnmarshalText implements encoding.TextUnmarshaler.
func (s *ConnectV1AlterOffsetRequestType) UnmarshalText(data []byte) error {
	switch ConnectV1AlterOffsetRequestType(data) {
	case ConnectV1AlterOffsetRequestTypePATCH:
		*s = ConnectV1AlterOffsetRequestTypePATCH
		return nil
	case ConnectV1AlterOffsetRequestTypeDELETE:
		*s = ConnectV1AlterOffsetRequestTypeDELETE
		return nil
	default:
		return errors.Errorf("invalid value: %q", data)
	}
}






