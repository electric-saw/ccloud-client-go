			NullQueryV1alpha1ResultValue QueryV1alpha1ResultValueType = "struct{}"
			StringQueryV1alpha1ResultValue QueryV1alpha1ResultValueType = "string"
			QueryV1alpha1ResultValueArrayQueryV1alpha1ResultValue QueryV1alpha1ResultValueType = "[]QueryV1alpha1ResultValue"
)
		// IsNull reports whether QueryV1alpha1ResultValue is struct{}.
		func (s QueryV1alpha1ResultValue) IsNull() bool { return s.Type == NullQueryV1alpha1ResultValue }
		// IsString reports whether QueryV1alpha1ResultValue is string.
		func (s QueryV1alpha1ResultValue) IsString() bool { return s.Type == StringQueryV1alpha1ResultValue }
		// IsQueryV1alpha1ResultValueArray reports whether QueryV1alpha1ResultValue is []QueryV1alpha1ResultValue.
		func (s QueryV1alpha1ResultValue) IsQueryV1alpha1ResultValueArray() bool { return s.Type == QueryV1alpha1ResultValueArrayQueryV1alpha1ResultValue }
	// SetNull sets QueryV1alpha1ResultValue to struct{}.
