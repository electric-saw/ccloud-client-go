// MarshalText implements encoding.TextMarshaler.
func (s EntityHeaderStatus) MarshalText() ([]byte, error) {
	switch s {
	case EntityHeaderStatusACTIVE:
		return []byte(s), nil
	case EntityHeaderStatusDELETED:
		return []byte(s), nil
	case EntityHeaderStatusPURGED:
		return []byte(s), nil
	default:
